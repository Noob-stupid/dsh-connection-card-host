{
  "name": "@noob-stupid/dsh-connection-card-host",
  "version": "1.0.37",
  "description": "会话连接卡片宿主：在DSH会话间建立有状态连接，挂载连接级卡片插件",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Noob-stupid/dsh-connection-card-host.git"
  },
  "homepage": "https://github.com/Noob-stupid/dsh-connection-card-host#readme",
  "bugs": {
    "url": "https://github.com/Noob-stupid/dsh-connection-card-host/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "connection",
    "card"
  ],
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "files": [
    "lib",
    "cards",
    "docs",
    "cordis.patch.yml"
  ],
  "license": "BSD-3-Clause",
  "author": "Noob-stupid (https://github.com/Noob-stupid)",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <4.1.0",
    "@deepseek-ai/dsh": ">=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/dsh-client-runtime": ">=0.2.0-rc.1 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh": { "optional": true },
    "@deepseek-ai/dsh-client-ui-slots": { "optional": true },
    "@deepseek-ai/dsh-client-runtime": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.0",
    "tsdown": "^0.22.14"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:client": "tsdown",
    "test": "node scripts/test-tool-scoping.mjs && node scripts/test-preempt.mjs && node scripts/test-install.mjs && node scripts/test-adapter.mjs && node scripts/test-shim.mjs && node scripts/test-bridge.mjs && node scripts/test-status.mjs && node scripts/test-host-wiring.mjs && node scripts/test-capabilities.mjs && node scripts/test-ui-capture.mjs && node scripts/test-symlink-tar.mjs && node scripts/test-escape-entries.mjs && node scripts/experiment-real-plugin.mjs"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "cordis.patch.yml"
    }
  }
}
